# Copy to .env.local (do not commit secrets). Used by capacitor.config.ts at sync time.
CAPACITOR_SERVER_URL=https://YOUR-DEPLOYED-OZINTEL-URL

# Printable tax invoice — seller / bank details (NEXT_PUBLIC_* baked in at build)
NEXT_PUBLIC_OZINTEL_BUSINESS_NAME=Collingullie Hotel
# Use \n for line breaks in the address
NEXT_PUBLIC_OZINTEL_BUSINESS_ADDRESS=10 Lockhart Road,\nCollingullie, NSW, 2650
NEXT_PUBLIC_OZINTEL_ABN=79 095 176 373
NEXT_PUBLIC_OZINTEL_BANK_NAME=ANZ
NEXT_PUBLIC_OZINTEL_BANK_ACCOUNT_NAME=Collingullie Hotel
NEXT_PUBLIC_OZINTEL_BANK_BSB=012-823
NEXT_PUBLIC_OZINTEL_BANK_ACCOUNT=4236-236-56
# Default owner for one-time migration of legacy shared module data into a user silo
OZINTEL_DEFAULT_OWNER_EMAIL=mattquade2000@gmail.com
